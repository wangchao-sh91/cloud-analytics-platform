{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "naming",
    "frontend",
    "backend",
    "database",
    "migration"
  ],
  "properties": {
    "naming": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "release",
            "legacy"
          ]
        }
      }
    },
    "frontend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image",
        "replicas",
        "resources"
      ],
      "properties": {
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "tag",
            "pullPolicy"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1
            },
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        },
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "type": "object"
        }
      }
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image",
        "replicas",
        "resources"
      ],
      "properties": {
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "tag",
            "pullPolicy"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1
            },
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        },
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "type": "object"
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image",
        "name",
        "user",
        "persistence",
        "resources"
      ],
      "properties": {
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "tag",
            "pullPolicy"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "pattern": "^17([.][0-9]+)*(-[a-z0-9.-]+)?$"
            },
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,62}$"
        },
        "user": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,62}$"
        },
        "resources": {
          "type": "object"
        },
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "storageClass",
            "size"
          ],
          "properties": {
            "storageClass": {
              "type": "string"
            },
            "size": {
              "type": "string",
              "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$"
            }
          }
        }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "waitSeconds",
        "deadlineSeconds",
        "backoffLimit"
      ],
      "properties": {
        "waitSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1800
        },
        "deadlineSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "backoffLimit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        }
      }
    }
  }
}
